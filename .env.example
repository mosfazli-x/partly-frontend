# Browser requests stay on the storefront's origin, including when shared over LAN.
NUXT_PUBLIC_API_BASE=/api
# Change localhost to the backend machine's LAN IP when using a remote API.
NUXT_API_TARGET=http://localhost:4000/api
# The interactive 3D garage is implemented but hidden while its model archive is
# incomplete. Set to true to show it again. Requires a rebuild/restart.
NUXT_PUBLIC_ENABLE_3D_GARAGE=false
